rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cadastre os operadores manualmente no Firebase Authentication.
    // Somente usuários autenticados podem acessar os dados desta frota.
    match /equipamentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /locacoes/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
